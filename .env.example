# Everything is optional. With nothing set, Ezvor runs local-first with free
# code runners and a keyless AI fallback.

# Public site URL (canonical links, sitemap, OG tags)
VITE_SITE_URL=https://qeelo.cloud

# ---- AI (first configured provider wins, others are automatic fallbacks) ----
GEMINI_API_KEY=            # free: https://aistudio.google.com/apikey
GROQ_API_KEY=              # free: https://console.groq.com/keys
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=        # free ":free" models
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# AI_BASE_URL= / AI_API_KEY= / AI_MODEL=   any OpenAI-compatible endpoint
# AI_PROVIDERS=gemini,groq                  change provider order
# AI_KEYLESS_FALLBACK=false                 disable the keyless last resort

# ---- Supabase (accounts, sync, shared cache) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server only, never VITE_

# ---- Optional search / scraping upgrades (keyless fallbacks exist) ----
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
JINA_API_KEY=

# ---- Optional self-hosted code runners (used before the free public ones) ----
# PISTON_URL=https://your-piston/api/v2
# JUDGE0_URL=https://your-judge0
# RUNNER_ORDER=piston,wandbox,paiza

# Cron auth for /api/public/hooks/refresh-statuses (Vercel sends it automatically)
CRON_SECRET=
